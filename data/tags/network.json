{
  "name": "network",
  "description": "Networking utilities and tools",
  "depends_on": [],
  "packages": {
    "alpine": {
      "all": {
        "apk": ["iperf3", "mosh", "openssh", "rsync", "tailscale", "websocat"]
      }
    },
    "arch": {
      "all": {
        "pacman": [
          "iperf3",
          "mosh",
          "openbsd-netcat",
          "openssh",
          "rsync",
          "tailscale",
          "websocat"
        ]
      }
    },
    "cachyos": {
      "all": {
        "pacman": [
          "iperf3",
          "mosh",
          "openbsd-netcat",
          "openssh",
          "rsync",
          "tailscale",
          "websocat"
        ]
      }
    },
    "debian": {
      "all": {
        "apt": [
          "iperf3",
          "mosh",
          "netcat-openbsd",
          "openssh-client",
          "openssh-server",
          "rsync"
        ],
        "homebrew": ["tailscale"]
      }
    },
    "freebsd": {
      "all": {
        "freebsd_pkd": [
          "iperf3",
          "mosh",
          "netcat",
          "rsync",
          "tailscale",
          "websocat"
        ]
      }
    },
    "macos": {
      "all": {
        "homebrew": ["iperf3", "mosh", "netcat", "rsync", "websocat"]
      }
    },
    "openbsd": {
      "all": {
        "openbsd_pkd": ["iperf3", "mosh", "rsync"]
      }
    },
    "ubuntu": {
      "all": {
        "apt": [
          "iperf3",
          "mosh",
          "netcat-openbsd",
          "openssh-client",
          "openssh-server",
          "rsync"
        ],
        "homebrew": ["tailscale"]
      }
    }
  },
  "hooks": {
    "configure": {
      "all": {
        "all": ["ssh-key", "tailscale"]
      }
    }
  }
}
